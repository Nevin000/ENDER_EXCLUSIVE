rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin' &&
        getUserData().status == 'active';
    }

    // ─── COLLECTION RULES ───────────────────────────────────────────────────

    // 1. USERS COLLECTION (`users/{userId}`)
    // 🔴 SECURITY FIX: Block self-privilege escalation (cannot assign role='admin' or status='active')
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // On account registration: role MUST be 'user' (cannot set 'admin')
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && (!('status' in request.resource.data) || request.resource.data.status == 'active');
                    
      // On update: Non-admin users CANNOT modify 'role' or 'status' fields
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))
                    || isAdmin();
                    
      allow delete: if isAdmin();
    }

    // 2. ORDERS COLLECTION (`orders/{orderId}`)
    // 🔴 SECURITY FIX: Lock down order creation & customer modification limits
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      // Customer creation: must match auth UID and initialize with pending status
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.orderStatus == 'pending';
                    
      // Customer update: Limited strictly to submitting payment proof for verification ('verification_pending')
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProof', 'paymentStatus', 'updatedAt']) &&
        request.resource.data.paymentStatus == 'verification_pending' &&
        resource.data.paymentStatus == 'pending'
      );
      
      allow delete: if isAdmin();
    }

    // 3. CART COLLECTION (`cart/{userId}`)
    match /cart/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 4. WISHLIST COLLECTION (`wishlist/{userId}`)
    match /wishlist/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 5. PRODUCTS COLLECTION (`products/{productId}`)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. CATEGORIES & COLLECTIONS (`categories/{categoryId}`, `collections/{collectionId}`)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. LOOKBOOKS COLLECTION (`lookbooks/{lookbookId}`)
    match /lookbooks/{lookbookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. REVIEWS COLLECTION (`reviews/{reviewId}`)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn()
                       && resource.data.userId == request.auth.uid
                       && request.resource.data.userId == resource.data.userId)
                    || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 9. SETTINGS & ADMIN MANAGEMENT (`settings/{settingId}`, `admin/{docId}`)
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    // 10. DEFAULT DENY ALL
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
